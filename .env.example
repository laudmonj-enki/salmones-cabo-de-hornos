# Variables de entorno del backend (Rails). Define tus propios valores.
# No subas contraseñas reales a Git.

# Contraseña del usuario sch_app de PostgreSQL (desarrollo y pruebas)
SCH_DATABASE_PASSWORD=cambia_esto

# Opcional: hilos de Rails (por defecto 5)
# RAILS_MAX_THREADS=5

# Solo producción
# BACKEND_DATABASE_PASSWORD=